{
  "collectionName": "components_blocks_spacer_blocks",
  "info": {
    "displayName": "Spacer Block",
    "icon": "arrows-alt-v",
    "description": "Visual spacing or divider between blocks"
  },
  "attributes": {
    "height": {
      "type": "enumeration",
      "enum": ["small", "medium", "large", "extra-large"],
      "default": "medium"
    },
    "showDivider": {
      "type": "boolean",
      "default": false
    },
    "dividerColor": {
      "type": "string",
      "default": "#e5e7eb"
    },
    "visibility": {
      "type": "enumeration",
      "enum": ["all", "desktop-only", "mobile-only"],
      "default": "all"
    }
  }
}
