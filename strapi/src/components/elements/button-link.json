{
  "collectionName": "components_elements_button_links",
  "info": {
    "displayName": "Button Link",
    "description": "A clickable button with a link"
  },
  "attributes": {
    "label": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "url": {
      "type": "string",
      "required": true
    },
    "variant": {
      "type": "enumeration",
      "enum": ["primary", "secondary", "outline"],
      "default": "primary"
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false
    }
  }
}
