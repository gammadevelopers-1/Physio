{
  "collectionName": "components_blocks_cta_banners",
  "info": {
    "displayName": "CTA Banner",
    "icon": "megaphone",
    "description": "Call-to-action section with text, image, and button"
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "centered",
        "image-left",
        "image-right"
      ],
      "default": "centered"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "buttons": {
      "type": "component",
      "repeatable": true,
      "component": "elements.button-link"
    },
    "visibility": {
      "type": "enumeration",
      "enum": [
        "all",
        "desktop-only",
        "mobile-only"
      ],
      "default": "all"
    },
    "position": {
      "type": "enumeration",
      "enum": [
        "top",
        "after-section-1",
        "after-section-2",
        "after-section-3",
        "after-section-4",
        "after-section-5",
        "after-section-6",
        "bottom"
      ],
      "default": "bottom"
    }
  }
}
