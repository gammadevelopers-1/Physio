# ===========================================
# PhysioGuidance API - Environment Variables
# ===========================================
# Copy this file to .env.local for local development
# NEVER commit real values to git!
# ===========================================

# ===========================================
# Application
# ===========================================
NODE_ENV=development
PORT=8080
API_PREFIX=api
LOG_LEVEL=debug

# ===========================================
# Database (PostgreSQL)
# ===========================================
# Local (Docker)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=physioguidance
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Production (Cloud SQL) - set via Secret Manager
# DATABASE_URL=postgresql://user:password@/dbname?host=/cloudsql/project:region:instance

# ===========================================
# Google Cloud Platform
# ===========================================
GCP_PROJECT_ID=physioguidance
GCP_REGION=us-central1

# Local development: path to service account key (optional)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ===========================================
# Cloud Storage
# ===========================================
STORAGE_BUCKET_PUBLIC=physioguidance-public
STORAGE_BUCKET_PRIVATE=physioguidance-private
STORAGE_BUCKET_TRAINERS=physioguidance-trainers
STORAGE_SIGNED_URL_EXPIRATION=60

# ===========================================
# CORS
# ===========================================
CORS_ORIGIN=http://localhost:3000

# ===========================================
# Authentication
# ===========================================
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7

# Google reCAPTCHA v2 (checkbox) — required for /auth/login + /auth/register
# Get keys at https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# ===========================================
# Email
# ===========================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user
# SMTP_PASSWORD=password
# MAIL_FROM=noreply@physioguidance.org

# ===========================================
# Zoom Integration
# ===========================================
# Server-to-Server OAuth credentials (from Zoom Marketplace app)
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret

# Webhook verification secret (from Zoom webhook settings)
ZOOM_WEBHOOK_SECRET=your-zoom-webhook-secret-token

# Set to "true" to use mock Zoom service (local dev without real credentials)
ZOOM_MOCK=true

# ===========================================
# Redis (required for BullMQ job queues)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ===========================================
# Payment Gateways
# ===========================================
PAYMENT_CALLBACK_URL=http://localhost:3000/payment/callback
PAYMENT_WEBHOOK_BASE_URL=http://localhost:8080/api/webhooks

# Moyasar (get test keys from https://moyasar.com)
# MOYASAR_MODE selects between test/live key sets (defaults to 'test').
MOYASAR_MODE=test
MOYASAR_PUBLISHABLE_KEY_TEST=
MOYASAR_SECRET_KEY_TEST=
MOYASAR_WEBHOOK_SECRET_TEST=
MOYASAR_PUBLISHABLE_KEY_LIVE=
MOYASAR_SECRET_KEY_LIVE=
MOYASAR_WEBHOOK_SECRET_LIVE=

# Tamara BNPL (get sandbox credentials from https://portal.tamara.co)
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
TAMARA_API_URL=https://api-sandbox.tamara.co

# Tabby BNPL (get credentials from https://tabby.ai/en-sa/business)
TABBY_SECRET_KEY=
TABBY_PUBLIC_KEY=
TABBY_WEBHOOK_SECRET=

# Bank Transfer: no env vars — bank account info is configured via
# admin Settings → Payments → Bank Transfer (stored in system_settings).

# ===========================================
# NELC LRS (xAPI) — Saudi National eLearning Center
# ===========================================
# When NELC_LRS_ENABLED=false, statement rows are persisted but never
# POSTed to NELC. Keep disabled locally so dev events don't flood
# their staging endpoint. Toggle to true in staging/prod only.
NELC_LRS_ENABLED=false
# Default mode applied when system_settings.nelc.mode hasn't been set.
# Admins can flip between staging/production from the NELC Integration
# admin page; this is only the bootstrap fallback. Use 'staging' for
# safety — production cutover should be an explicit admin click.
NELC_LRS_MODE=staging
# Both endpoints are kept side-by-side so the admin toggle can switch
# without redeploy. NELC_LRS_ENDPOINT (singular) is still read as a
# legacy fallback for NELC_LRS_ENDPOINT_STAGING.
NELC_LRS_ENDPOINT_STAGING=https://lrs.nelc.gov.sa/lrs-license-stg/xapi/statements
NELC_LRS_ENDPOINT_PROD=https://lrs.nelc.gov.sa/lrs-nelc/xapi/statements
# Basic auth credentials issued by NELC for this platform — same
# username across both environments, separate passwords.
NELC_LRS_USERNAME=
# Already-base64-encoded by NELC — paste verbatim (Basic auth then
# encodes "username:password" again per RFC, not a bug).
NELC_LRS_PASSWORD=
NELC_LRS_PASSWORD_PROD=
# The platform identifier NELC matches against. For PhysioGuidance,
# the full public URL (as supplied by NELC in the staging creds file).
NELC_PLATFORM_IDENTIFIER=https://physioguidance.org/
# Bilingual platform name sent in the NELC custom extension.
NELC_PLATFORM_NAME_EN=PhysioGuidance
NELC_PLATFORM_NAME_AR=فيزيو جايدنس
# Base URL for canonical activity IDs (e.g. {NELC_LMS_URL}/courses/<id>).
# NELC may dereference these — use the public production URL even in
# staging to avoid 404s on their side.
NELC_LMS_URL=https://physioguidance.org
# Per-request timeout for LRS POSTs (ms). 15s tolerates NELC's cold
# paths without blocking the queue worker.
NELC_LRS_TIMEOUT_MS=15000
# Max retries per statement before status flips to 'failed'. The cron
# flush re-picks failed rows on its hourly tick regardless.
NELC_LRS_MAX_ATTEMPTS=3

# ===========================================
# Production URL (used for file URLs in DB)
# ===========================================
# APP_URL=https://api.physioguidance.org/api

# ===========================================
# Sentry — Backend Side (Admin Error Monitoring Dashboard)
# ===========================================
# Backend reads aggregated error data from Sentry's REST API and surfaces
# it on the admin Settings → Error Monitoring tab. Tokens come from a
# Sentry Internal Integration (Settings → Custom Integrations).

# Org slug (e.g. "physioguidance" if your URL is physioguidance.sentry.io).
SENTRY_ORG=
# Project slug — must match the project you sent events to.
SENTRY_PROJECT=
# Sentry region host — "sentry.io" (US) or "de.sentry.io" (EU/Germany).
# Determined by where you created your org. SDAIA compliance prefers EU.
SENTRY_API_HOST=de.sentry.io
# Internal Integration auth token — scopes: project:read, event:read,
# org:read, issue:read+write, alerts:read+write. NEVER commit real values.
SENTRY_API_TOKEN=
# Internal Integration client secret — used to verify the HMAC signature
# on every webhook POST from Sentry → /api/webhooks/sentry/alert.
SENTRY_WEBHOOK_SECRET=
