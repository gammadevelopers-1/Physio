{
  "collectionName": "components_blocks_treatment_gallery_blocks",
  "info": {
    "displayName": "Treatment Gallery Block",
    "icon": "images",
    "description": "Categorized visual reference of physiotherapy techniques"
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "techniques": {
      "type": "component",
      "repeatable": true,
      "component": "elements.treatment-technique-item"
    },
    "filterByCategory": {
      "type": "boolean",
      "default": true
    },
    "columns": {
      "type": "enumeration",
      "enum": ["2", "3", "4"],
      "default": "3"
    },
    "visibility": {
      "type": "enumeration",
      "enum": ["all", "desktop-only", "mobile-only"],
      "default": "all"
    }
  }
}
