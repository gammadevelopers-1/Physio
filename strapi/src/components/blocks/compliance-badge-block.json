{
  "collectionName": "components_blocks_compliance_badge_blocks",
  "info": {
    "displayName": "Compliance Badge Block",
    "icon": "check-double",
    "description": "NELC/SCFHS/MOH regulatory compliance visual indicators"
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "badges": {
      "type": "component",
      "repeatable": true,
      "component": "elements.compliance-badge-item"
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "row",
        "grid",
        "detailed"
      ],
      "default": "row"
    },
    "visibility": {
      "type": "enumeration",
      "enum": [
        "all",
        "desktop-only",
        "mobile-only"
      ],
      "default": "all"
    },
    "position": {
      "type": "enumeration",
      "enum": [
        "top",
        "after-section-1",
        "after-section-2",
        "after-section-3",
        "after-section-4",
        "after-section-5",
        "after-section-6",
        "bottom"
      ],
      "default": "bottom"
    }
  }
}
