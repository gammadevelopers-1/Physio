{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Settings",
    "description": "Global site settings"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "files"]
    },
    "defaultOgImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "footerDescription": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "copyrightText": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "showSearchBar": {
      "type": "boolean",
      "default": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "showWhatsappButton": {
      "type": "boolean",
      "default": false,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "whatsappNumber": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "whatsappCompanyName": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "whatsappGreeting": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "whatsappReplyTime": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "instagramUrl": {
      "type": "string"
    },
    "twitterUrl": {
      "type": "string"
    },
    "linkedinUrl": {
      "type": "string"
    },
    "facebookUrl": {
      "type": "string"
    },
    "footerPlatformTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "footerOrganizationTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "footerSupportTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "footerMenuTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "paymentMethods": {
      "type": "component",
      "repeatable": true,
      "component": "elements.payment-method-item"
    },
    "commercialRegistrationLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "commercialRegistrationNumber": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "vatLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "vatNumber": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "nelcLicenseText": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "nelcLicenseLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "nelcLicenseNumber": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "nelcLogo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "themePrimaryColor": {
      "type": "string",
      "default": "#a37f49",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "themePrimaryDark": {
      "type": "string",
      "default": "#6b4e24",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "themeSurfacePage": {
      "type": "string",
      "default": "#EEF3F7",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "themeSurfaceCard": {
      "type": "string",
      "default": "#e5edf4",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "themeTextPrimary": {
      "type": "string",
      "default": "#171717",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "themeTextSecondary": {
      "type": "string",
      "default": "#737373",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "themeBorderColor": {
      "type": "string",
      "default": "#e5e7eb",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "themeBorderSubtle": {
      "type": "string",
      "default": "#C8D5E1",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "themeInputBorder": {
      "type": "string",
      "default": "#9CA3AF",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "themeInputFocus": {
      "type": "string",
      "default": "#a37f49",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "themeIconColor": {
      "type": "string",
      "default": "#737373",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "themeFooterBackground": {
      "type": "string",
      "default": "#ffffff",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "themeButtonText": {
      "type": "string",
      "default": "#ffffff",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "themeNavbarBackground": {
      "type": "string",
      "default": "#EEF3F7",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "themeNavbarText": {
      "type": "string",
      "default": "#171717",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "themeFooterHeading": {
      "type": "string",
      "default": "#171717",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "themeFooterText": {
      "type": "string",
      "default": "#171717",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "themeStarColor": {
      "type": "string",
      "default": "#F59E0B",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "themeStarBorder": {
      "type": "string",
      "default": "#E5E7EB",
      "pluginOptions": { "i18n": { "localized": false } }
    }
  }
}
