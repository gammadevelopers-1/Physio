{
  "displayName": "Suspicious 403 burst (>50 in 5 min)",
  "documentation": {
    "content": "Fires when >50 403 Forbidden responses from the backend occur in a 5-minute window. Catches: CSRF failures, unauthorized resource probing, role-elevation attempts, scraper bots hitting protected routes.\n\nResponse: check audit_logs filtered by the offending IP, identify whether one client is misconfigured (legitimate user) or whether it's a hostile scan.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "backend_403_count > 50 over 5 min",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/backend_403_count\" AND resource.type=\"cloud_run_revision\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_SUM",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 50,
        "duration": "0s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "alertStrategy": {
    "autoClose": "1800s"
  },
  "notificationChannels": [
    "projects/nelc-elearning-platform-479319/notificationChannels/15422204998454221054",
    "projects/nelc-elearning-platform-479319/notificationChannels/12592801043257337597"
  ],
  "enabled": true
}
