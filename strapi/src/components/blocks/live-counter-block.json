{
  "collectionName": "components_blocks_live_counter_blocks",
  "info": {
    "displayName": "Live Counter Block",
    "icon": "sort-numeric-up",
    "description": "Animated counters for key metrics"
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "counters": {
      "type": "component",
      "repeatable": true,
      "component": "elements.counter-item"
    },
    "animationDuration": {
      "type": "integer",
      "default": 2000
    },
    "backgroundColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "visibility": {
      "type": "enumeration",
      "enum": [
        "all",
        "desktop-only",
        "mobile-only"
      ],
      "default": "all"
    },
    "position": {
      "type": "enumeration",
      "enum": [
        "top",
        "after-section-1",
        "after-section-2",
        "after-section-3",
        "after-section-4",
        "after-section-5",
        "after-section-6",
        "bottom"
      ],
      "default": "bottom"
    }
  }
}
