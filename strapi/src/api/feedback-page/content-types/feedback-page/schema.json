    "formFullNameLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "formEmailLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "formSubjectLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "formDescriptionLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "formCharactersLeftPrefix": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "formCharactersLeftSuffix": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "formSubmitLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    }
