{
  "collectionName": "components_blocks_treatment_gallery_blocks",
  "info": {
    "displayName": "Treatment Gallery Block",
    "icon": "images",
    "description": "Categorized visual reference of physiotherapy techniques"
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "techniques": {
      "type": "component",
      "repeatable": true,
      "component": "elements.treatment-technique-item"
    },
    "filterByCategory": {
      "type": "boolean",
      "default": true
    },
    "columns": {
      "type": "enumeration",
      "enum": [
        "2",
        "3",
        "4"
      ],
      "default": "3"
    },
    "visibility": {
      "type": "enumeration",
      "enum": [
        "all",
        "desktop-only",
        "mobile-only"
      ],
      "default": "all"
    },
    "position": {
      "type": "enumeration",
      "enum": [
        "top",
        "after-section-1",
        "after-section-2",
        "after-section-3",
        "after-section-4",
        "after-section-5",
        "after-section-6",
        "bottom"
      ],
      "default": "bottom"
    }
  }
}
