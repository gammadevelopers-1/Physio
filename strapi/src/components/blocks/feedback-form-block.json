    "formDescriptionLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "formCharactersLeftPrefix": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "formCharactersLeftSuffix": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
