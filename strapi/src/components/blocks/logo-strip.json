{
  "collectionName": "components_blocks_logo_strips",
  "info": {
    "displayName": "Logo Strip",
    "icon": "image",
    "description": "A strip of logo images in grid or marquee"
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "logos": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "enableMarquee": {
      "type": "boolean",
      "default": true
    },
    "visibility": {
      "type": "enumeration",
      "enum": ["all", "desktop-only", "mobile-only"],
      "default": "all"
    }
  }
}
