{
  "kind": "singleType",
  "collectionName": "support_pages",
  "info": {
    "singularName": "support-page",
    "pluralName": "support-pages",
    "displayName": "Support Page",
    "description": "Public support page content (categories, FAQ, hero copy)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.accordion-block",
        "blocks.accreditation-badges-block",
        "blocks.anchor-links-block",
        "blocks.announcement-banner-block",
        "blocks.cards-grid",
        "blocks.cta-banner",
        "blocks.faq-accordion",
        "blocks.hero-banner",
        "blocks.logo-strip",
        "blocks.partners-strip",
        "blocks.rich-text-block",
        "blocks.section-header-block",
        "blocks.spacer-block"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "subtitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "categoriesTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "categoriesSubtitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "categories": {
      "type": "component",
      "repeatable": true,
      "component": "shared.support-category",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "faqTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "faqViewAllLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "shared.faq-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "submitTicketTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "submitTicketSubtitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "signInRequiredLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "signInRequiredDescription": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "signInLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
