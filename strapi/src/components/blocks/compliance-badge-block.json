{
  "collectionName": "components_blocks_compliance_badge_blocks",
  "info": {
    "displayName": "Compliance Badge Block",
    "icon": "check-double",
    "description": "NELC/SCFHS/MOH regulatory compliance visual indicators"
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "badges": {
      "type": "component",
      "repeatable": true,
      "component": "elements.compliance-badge-item"
    },
    "variant": {
      "type": "enumeration",
      "enum": ["row", "grid", "detailed"],
      "default": "row"
    },
    "visibility": {
      "type": "enumeration",
      "enum": ["all", "desktop-only", "mobile-only"],
      "default": "all"
    }
  }
}
