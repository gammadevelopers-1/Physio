{
  "collectionName": "components_blocks_tabs_blocks",
  "info": {
    "displayName": "Tabs Block",
    "icon": "folder",
    "description": "Tabbed content sections"
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "tabs": {
      "type": "component",
      "repeatable": true,
      "component": "elements.tab-item"
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "horizontal",
        "vertical"
      ],
      "default": "horizontal"
    },
    "visibility": {
      "type": "enumeration",
      "enum": [
        "all",
        "desktop-only",
        "mobile-only"
      ],
      "default": "all"
    },
    "position": {
      "type": "enumeration",
      "enum": [
        "top",
        "after-section-1",
        "after-section-2",
        "after-section-3",
        "after-section-4",
        "after-section-5",
        "after-section-6",
        "bottom"
      ],
      "default": "bottom"
    }
  }
}
