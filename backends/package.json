{
  "name": "physioguidance-api",
  "version": "1.0.0",
  "description": "PhysioGuidance Healthcare eLearning API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "docker:dev": "docker-compose -f ../docker-compose.yml up",
    "docker:dev:build": "docker-compose -f ../docker-compose.yml up --build",
    "docker:dev:down": "docker-compose -f ../docker-compose.yml down",
    "docker:prod:build": "docker build -f ../infra/backend/production/Dockerfile -t physioguidance-api .",
    "deploy": "../infra/backend/deploy.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "ts-node src/database/seeds/index.ts",
    "db:seed:roles": "ts-node src/database/seed-roles.ts",
    "db:seed:scfhs": "ts-node src/database/seed-scfhs-numbers.ts",
    "db:seed:kb": "ts-node src/database/seeds/seed-kb.ts",
    "db:reset": "npm run db:push && npm run db:seed:roles"
  },
  "dependencies": {
    "@google-cloud/monitoring": "^5.4.0",
    "@google-cloud/run": "^3.3.0",
    "@google-cloud/storage": "^7.18.0",
    "@google-cloud/tasks": "^6.3.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@sentry/nestjs": "^10.70.0",
    "@sentry/profiling-node": "^10.70.0",
    "adm-zip": "^0.5.16",
    "arabic-reshaper": "^1.1.0",
    "archiver": "^8.0.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.1",
    "exceljs": "^4.4.0",
    "fluent-ffmpeg": "^2.1.3",
    "fontkit": "^2.0.2",
    "google-auth-library": "^9.15.1",
    "ioredis": "^5.4.0",
    "isomorphic-dompurify": "^3.14.0",
    "nodemailer": "^8.0.1",
    "openai": "^4.60.0",
    "opentype.js": "^1.3.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.18.0",
    "puppeteer-core": "^24.40.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.0",
    "resend": "^6.9.2",
    "rxjs": "^7.8.1",
    "svg-to-pdfkit": "^0.1.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^7.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.17",
    "@types/fluent-ffmpeg": "^2.1.25",
    "@types/jest": "^29.5.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^7.0.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
