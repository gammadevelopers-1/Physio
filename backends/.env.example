# ===========================================
# PhysioGuidance API - Environment Variables
# ===========================================
# Copy this file to .env.local for local development
# NEVER commit real values to git!
# ===========================================

# ===========================================
# Application
# ===========================================
NODE_ENV=development
PORT=8080
API_PREFIX=api
LOG_LEVEL=debug

# ===========================================
# Database (PostgreSQL)
# ===========================================
# Local (Docker)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=physioguidance
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Production (Cloud SQL) - set via Secret Manager
# DATABASE_URL=postgresql://user:password@/dbname?host=/cloudsql/project:region:instance

# ===========================================
# Google Cloud Platform
# ===========================================
GCP_PROJECT_ID=physioguidance
GCP_REGION=us-central1

# Local development: path to service account key (optional)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ===========================================
# Cloud Storage
# ===========================================
STORAGE_BUCKET_PUBLIC=physioguidance-public
STORAGE_BUCKET_PRIVATE=physioguidance-private
STORAGE_BUCKET_TRAINERS=physioguidance-trainers
STORAGE_SIGNED_URL_EXPIRATION=60

# ===========================================
# CORS
# ===========================================
CORS_ORIGIN=http://localhost:3000

# ===========================================
# Authentication
# ===========================================
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7

# ===========================================
# Email
# ===========================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user
# SMTP_PASSWORD=password
# MAIL_FROM=noreply@physioguidance.org

# ===========================================
# Zoom Integration
# ===========================================
# Server-to-Server OAuth credentials (from Zoom Marketplace app)
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret

# Webhook verification secret (from Zoom webhook settings)
ZOOM_WEBHOOK_SECRET=your-zoom-webhook-secret-token

# Set to "true" to use mock Zoom service (local dev without real credentials)
ZOOM_MOCK=true

# ===========================================
# Redis (required for BullMQ job queues)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ===========================================
# Payment Gateways
# ===========================================
PAYMENT_CALLBACK_URL=http://localhost:3000/payment/callback
PAYMENT_WEBHOOK_BASE_URL=http://localhost:8080/api/webhooks

# Tap Payments (get test keys from https://www.tap.company/sa-en/developers)
TAP_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX
TAP_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX
TAP_WEBHOOK_SECRET=
TAP_ENCRYPTION_KEY=
TAP_MERCHANT_ID=

# Moyasar (get test keys from https://moyasar.com)
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=

# Tamara BNPL (get sandbox credentials from https://portal.tamara.co)
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
TAMARA_API_URL=https://api-sandbox.tamara.co

# Tabby BNPL (get credentials from https://tabby.ai/en-sa/business)
TABBY_SECRET_KEY=
TABBY_PUBLIC_KEY=
TABBY_WEBHOOK_SECRET=

# ===========================================
# Production URL (used for file URLs in DB)
# ===========================================
# APP_URL=https://api.physioguidance.org/api
