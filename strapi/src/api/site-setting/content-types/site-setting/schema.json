    "linkedinUrl": {
      "type": "string"
    },
    "facebookUrl": {
      "type": "string"
    },
    "footerPlatformTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "footerOrganizationTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
