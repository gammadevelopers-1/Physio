{
  "collectionName": "components_blocks_stats_numbers_blocks",
  "info": {
    "displayName": "Stats / Numbers Block",
    "icon": "chart-bar",
    "description": "Display statistics or key numbers"
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "elements.stat-item"
    },
    "visibility": {
      "type": "enumeration",
      "enum": [
        "all",
        "desktop-only",
        "mobile-only"
      ],
      "default": "all"
    },
    "position": {
      "type": "enumeration",
      "enum": [
        "top",
        "after-section-1",
        "after-section-2",
        "after-section-3",
        "after-section-4",
        "after-section-5",
        "after-section-6",
        "bottom"
      ],
      "default": "bottom"
    }
  }
}
