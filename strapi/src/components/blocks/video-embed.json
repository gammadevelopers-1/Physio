{
  "collectionName": "components_blocks_video_embeds",
  "info": {
    "displayName": "Video Embed",
    "icon": "play",
    "description": "Embedded video section with optional title"
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "videoFile": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["videos"]
    },
    "videoUrl": {
      "type": "string"
    },
    "autoplay": {
      "type": "boolean",
      "default": false
    },
    "visibility": {
      "type": "enumeration",
      "enum": ["all", "desktop-only", "mobile-only"],
      "default": "all"
    }
  }
}
