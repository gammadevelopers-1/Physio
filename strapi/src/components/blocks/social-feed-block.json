{
  "collectionName": "components_blocks_social_feed_blocks",
  "info": {
    "displayName": "Social Feed Block",
    "icon": "share-alt",
    "description": "Embedded social media posts feed"
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "posts": {
      "type": "component",
      "repeatable": true,
      "component": "elements.social-link"
    },
    "columns": {
      "type": "enumeration",
      "enum": ["2", "3", "4"],
      "default": "3"
    },
    "visibility": {
      "type": "enumeration",
      "enum": ["all", "desktop-only", "mobile-only"],
      "default": "all"
    }
  }
}
