{
  "kind": "collectionType",
  "collectionName": "navigation_links",
  "info": {
    "singularName": "navigation-link",
    "pluralName": "navigation-links",
    "displayName": "Navigation Link",
    "description": "Navigation and footer links"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "label": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "url": {
      "type": "string",
      "required": true
    },
    "location": {
      "type": "enumeration",
      "enum": ["navbar", "footer-platform", "footer-organization", "footer-support"],
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "hasDropdown": {
      "type": "boolean",
      "default": false
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false
    }
  }
}
