{
  "collectionName": "components_blocks_related_pages_blocks",
  "info": {
    "displayName": "Related Pages Block",
    "icon": "th-large",
    "description": "Curated grid of internal page links with thumbnails"
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "pages": {
      "type": "component",
      "repeatable": true,
      "component": "elements.related-page-item"
    },
    "columns": {
      "type": "enumeration",
      "enum": ["2", "3", "4"],
      "default": "3"
    },
    "visibility": {
      "type": "enumeration",
      "enum": ["all", "desktop-only", "mobile-only"],
      "default": "all"
    }
  }
}
