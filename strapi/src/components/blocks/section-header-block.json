{
  "collectionName": "components_blocks_section_header_blocks",
  "info": {
    "displayName": "Section Header Block",
    "icon": "heading",
    "description": "Styled section divider with title and subtitle"
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "subtitle": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "alignment": {
      "type": "enumeration",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "center"
    },
    "showDivider": {
      "type": "boolean",
      "default": true
    },
    "headingLevel": {
      "type": "enumeration",
      "enum": [
        "h1",
        "h2",
        "h3",
        "h4"
      ],
      "default": "h2"
    },
    "anchorId": {
      "type": "string"
    },
    "visibility": {
      "type": "enumeration",
      "enum": [
        "all",
        "desktop-only",
        "mobile-only"
      ],
      "default": "all"
    },
    "position": {
      "type": "enumeration",
      "enum": [
        "top",
        "after-section-1",
        "after-section-2",
        "after-section-3",
        "after-section-4",
        "after-section-5",
        "after-section-6",
        "bottom"
      ],
      "default": "bottom"
    }
  }
}
