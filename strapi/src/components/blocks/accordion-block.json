{
  "collectionName": "components_blocks_accordion_blocks",
  "info": {
    "displayName": "Accordion Block",
    "icon": "list",
    "description": "Generic collapsible sections with rich text content"
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "elements.accordion-item"
    },
    "allowMultipleOpen": {
      "type": "boolean",
      "default": false
    },
    "visibility": {
      "type": "enumeration",
      "enum": ["all", "desktop-only", "mobile-only"],
      "default": "all"
    }
  }
}
