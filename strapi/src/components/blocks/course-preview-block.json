{
  "collectionName": "components_blocks_course_preview_blocks",
  "info": {
    "displayName": "Course Preview Block",
    "icon": "graduation-cap",
    "description": "Featured single course preview with video, description, and enroll CTA"
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "previewVideo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["videos"]
    },
    "previewVideoUrl": {
      "type": "string"
    },
    "previewImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "courseHighlights": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "enrollLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "enrollUrl": {
      "type": "string"
    },
    "price": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "duration": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "visibility": {
      "type": "enumeration",
      "enum": ["all", "desktop-only", "mobile-only"],
      "default": "all"
    }
  }
}
