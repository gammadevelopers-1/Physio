{
  "collectionName": "components_blocks_rich_text_blocks",
  "info": {
    "displayName": "Rich Text Block",
    "icon": "file-text",
    "description": "Free-form rich text content section"
  },
  "attributes": {
    "content": {
      "type": "richtext",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "maxWidth": {
      "type": "enumeration",
      "enum": [
        "narrow",
        "medium",
        "full"
      ],
      "default": "medium"
    },
    "visibility": {
      "type": "enumeration",
      "enum": [
        "all",
        "desktop-only",
        "mobile-only"
      ],
      "default": "all"
    },
    "position": {
      "type": "enumeration",
      "enum": [
        "top",
        "after-section-1",
        "after-section-2",
        "after-section-3",
        "after-section-4",
        "after-section-5",
        "after-section-6",
        "bottom"
      ],
      "default": "bottom"
    }
  }
}
