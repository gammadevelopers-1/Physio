{
  "collectionName": "components_blocks_timeline_blocks",
  "info": {
    "displayName": "Timeline Block",
    "icon": "clock",
    "description": "Step-by-step timeline or roadmap visualization"
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "steps": {
      "type": "component",
      "repeatable": true,
      "component": "elements.timeline-item"
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "vertical",
        "horizontal"
      ],
      "default": "vertical"
    },
    "visibility": {
      "type": "enumeration",
      "enum": [
        "all",
        "desktop-only",
        "mobile-only"
      ],
      "default": "all"
    },
    "position": {
      "type": "enumeration",
      "enum": [
        "top",
        "after-section-1",
        "after-section-2",
        "after-section-3",
        "after-section-4",
        "after-section-5",
        "after-section-6",
        "bottom"
      ],
      "default": "bottom"
    }
  }
}
