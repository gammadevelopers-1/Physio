{
  "collectionName": "components_blocks_download_resources_blocks",
  "info": {
    "displayName": "Download Resources Block",
    "icon": "download",
    "description": "Grid of downloadable files, guides, and whitepapers"
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "resources": {
      "type": "component",
      "repeatable": true,
      "component": "elements.download-item"
    },
    "columns": {
      "type": "enumeration",
      "enum": ["2", "3", "4"],
      "default": "3"
    },
    "visibility": {
      "type": "enumeration",
      "enum": ["all", "desktop-only", "mobile-only"],
      "default": "all"
    }
  }
}
